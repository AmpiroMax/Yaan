#
# Created: 17:08:2026 - 14:46:25
# Last updated: 17:08:2026 - 17:41:00
# Module: assets
# File: assets/signs/demo.signs
#
# Responsibility:
# - Паспорта трёх домов демки. Текст — КОНТЕНТ (правило 5): что это за
#   дом, ПОЧЕМУ такая архитектура, ПОЧЕМУ такие материалы.
#
# Dependencies:
# - Uses: dfn_signs / render::read_signs_file (печёт .dfo).
#   Used by: assets/scenes/demo.scene.
#
# AI Agents Notice (must follow):
# - СГЕНЕРИРОВАНО tools/gen_house_demo.py — правки в генератор, иначе
#   следующий прогон их сотрёт.
#
# UPD:
# - 17:08:2026 - 14:46:25: Создан генератором вместе с demo.scene.
# - 17:08:2026 - 15:22:41: Перевыпущен вместе со сценой (дома переставлены с троп).
# - 17:08:2026 - 17:10:24: Паспорт НАВЕСА-АРКИ (заказ B): чем свод собран и почему такой
#   формы — уклон звена это разность двух шарниров, а не свойство крыши.
# - 17:08:2026 - 17:28:41: Паспорт ЛЕСТНИЧНОЙ КЛЕТКИ (заказ C): длина проёма ВЫВЕДЕНА,
#   и на доске стоит само выведенное число до округления по сетке.
# - 17:08:2026 - 17:41:00: На доске ДВА числа со своими именами — с какого метра проём
#   НУЖЕН (d0 = d1 - L) и с какого начинается ДЕТАЛЬ после округления;
#   разница названа запасом. Раньше стояло одно число под чужим ярлыком.
#

[sign]
name = passport-log
shape = post
cap = 0.04
board = timber
ink = dark
wear = 0.3
line = ДОМ ОДНОЭТАЖНЫЙ, СРУБ
line = стена 13u = 3.25 м, потолок 2.90
line = бревно держит стену и тепло сразу
line = цоколь камень: бревно не в земле
line = солома: её кроют своими руками

[sign]
name = passport-frame
shape = post
cap = 0.04
board = timber
ink = dark
wear = 0.3
line = ПОЛУТОРАЭТАЖНЫЙ, ФАХВЕРК
line = каркас несёт, глина заполняет
line = дерева мало, а лес далеко
line = крутой марш 45: этаж за свою длину
line = антресоль под коньком, тепло вверху

[sign]
name = passport-stone
shape = post
cap = 0.04
board = timber
ink = dark
wear = 0.3
line = ДВУХЭТАЖНЫЙ, КАМЕНЬ И ДЕРЕВО
line = низ тёсаный камень: сырость, удар
line = верх фахверк: легче и теплее
line = камень внизу, дерево вверху —
line = тяжёлое стоит на земле
line = черепица: дом побогаче соседей

[sign]
name = passport-stair
shape = post
cap = 0.04
board = timber
ink = dark
wear = 0.3
line = ЛЕСТНИЧНАЯ КЛЕТКА С ПРОЁМОМ
line = марш 45°, 13 ступеней, этаж 3.25 м
line = низ на лежень нижнего уровня,
line = верх на лежень верхнего
line = проём 2.25 м — ВЫВЕДЕН: 2.195
line = вверх по сетке 0.25
line = макушка игрока полусфера,
line = она цепляет УГОЛ плиты первой
line = нужен с 1.055 м, деталь с 1.000
line = разница 0.055 м — это ЗАПАС

[sign]
name = passport-arch
shape = post
cap = 0.04
board = timber
ink = dark
wear = 0.3
line = НАВЕС-АРКА, СВОД ИЗ ЗВЕНЬЕВ
line = пролёт 10 м, подъём 3 м, глубина 4 м
line = звено низом на один лежень,
line = верхом на другой — уклон это
line = разность двух шарниров
line = у пяты 45°, у замка 18°
line = шарниры по дуге = арка,
line = по прямой = двускатная крыша

