# Daggerfall N — НАРОД: КАЙСАКИ — степной юг, народ орды, коней и курганов.
#
# ЭТО РАСПРЕДЕЛЕНИЕ, А НЕ ТОЧКА (CHARGEN_UI.md, Р8). Народ несёт для каждой
# ручки края [lo, hi], типаж — центр μ внутри них, а «Случайно» бросает
# УСЕЧЁННУЮ НОРМАЛЬ. Игроку файл даёт стартовую точку и сужает нарисованную
# дорожку; толпе — выборку. Один файл, два потребителя.
#
# ОТКУДА ЧИСЛА. Края СУДЕЙСКИЕ (секция MORF у HumanBase.dfo, измерены
# приёмкой шага 1) народ только СУЖАЕТ — выйти за них он не вправе, и
# читатель отказывает громко. Что именно сужено и почему — в [limits].
# Слова — из docs/story/PEOPLES_CHARGEN.md (сдача лороведа); ЧИСЛА полос и
# типажей — ПРЕДЛОЖЕНИЕ этой волны по тем словам, требует утверждения.
#
# ИМЕНА ПЕРЕНЕСЕНЫ ИЗ ДОКУМЕНТА МЕХАНИЧЕСКИ, все 120: 480 собственных имён
# руками не переносят — переносят с опечаткой, а имя народа с опечаткой
# нельзя ни увидеть, ни проверить.
#
# РАСХОЖДЕНИЕ ЛОРА И СУДЬИ, РАЗРЕШЁННОЕ В ПОЛЬЗУ СУДЬИ И ЗАПИСАННОЕ
# ЗДЕСЬ, А НЕ ЗАМОЛЧАННОЕ. Лоровед назвал предел НАРОДА, судья мерил
# КАНОН ПРОПОРЦИЙ, и разошлись они не по чьей-то ошибке:
#   — рост, верх: лор 1.90 м, судья 1.84 м -> взято 1.84.
# ЛОР НЕ ПЕРЕПИСАН. Это полоса РОСТА уже лора, а не лор шире правды:
# ход ползунка роста ограничен капсулой игрока и каноном 7.5-8.0 голов,
# и расширять его — тикет капсулы, а не правка этого файла.
#
# ЧЕГО У ЭТОГО НАРОДА НЕ БЫВАЕТ (лор, дословно):
#   — бледной северной кожи.
#   — льняных и рыжих волос (кроме 2 % «отмеченных огнём»).
#   — голубых глаз.
#   — бород лопатой (усы и редкая борода).
#   — роста выше 190.

id = kaysaki
order = 4
name_key = chargen.people.kaysaki
blurb_key = chargen.people.kaysaki.blurb

# --- КРАЯ НАРОДА -----------------------------------------------------------
# <ручка> = <lo> <hi>. Обязаны лежать ВНУТРИ судейской полосы; шире — отказ
# при чтении, а не молчаливое обрезание.
[limits]
# ПРАВИЛО МОЛЧАНИЯ: ручка, НЕ НАЗВАННАЯ здесь, берёт судейскую полосу
# ЦЕЛИКОМ. Повторять её числа рядом с комментарием «лор её не сужает» нельзя:
# повторённое число — копия, и она разошлась с оригиналом на первой же
# перепечке целей MORF (судья сузил belly с 0.45 до 0.43, и два народа были
# отвергнуты за полосу ШИРЕ судейской, которую никто не расширял).
arm-length = -0.55 0.7
belly = 0 0.3  # то же
buttocks = -1 0.55
deltoid = -0.75 0.8
hips = -0.75 0.55  # низ усечён судьёй: полоса начинается на -0.75 (тело MPFB, 02.09)
# leg-length СНЯТ 02.09 вместе с ручкой: на теле MPFB морф длины ног двигает
# меш, а не суставы, и судья держит его в ±0.078 хода (упор — «ankle
# height»): ползунок, который ничего не делает. Длина ног, как рост, —
# ручка скелета; вернётся, когда суставы поедут вместе с мешем.
muscle = -0.4 0.8
shoulders = -0.7 0.85
stature = 1.66 1.84  # УСЕЧЕНО СУДЬЁЙ сверху: лор назвал «не выше 190», судейская полоса кончается на 1.84
torso-depth = -0.85 0.1  # сухой торс; низ усечён судьёй: полоса начинается на -0.85 (тело MPFB, 02.09, упор — глубина груди)
weight = -1 0.35  # «конники солёной степи»: полных не бывает — верх подрезан вдвое

# --- ТИПАЖИ ----------------------------------------------------------------
# frequency — вес выборки, в процентах; сумма восьми обязана быть 100.
# Названы ТОЛЬКО те ручки, о которых лор сказал словами. Неназванная ручка
# берёт центр народа и σ = (hi−lo)/4 — то есть «про эту ручку типаж молчит»,
# а не «эта ручка у него ноль».

[archetype]
id = rider
name_key = chargen.archetype.kaysaki.rider
frequency = 25
# лор: «сухой, кривоногий, лёгкий»
hips = -0.1
muscle = 0.25
stature = 1.72
weight = -0.55

[archetype]
id = archer
name_key = chargen.archetype.kaysaki.archer
frequency = 15
# лор: «узкий, широкие плечи-клин»
deltoid = 0.35
hips = -0.45
shoulders = 0.6
weight = -0.4

[archetype]
id = herder
name_key = chargen.archetype.kaysaki.herder
frequency = 15
# лор: «жилистый, дублёный»
age = 0.3
muscle = 0.5
weight = -0.45

[archetype]
id = wrestler
name_key = chargen.archetype.kaysaki.wrestler
frequency = 10
# лор: «бочонок, шея-столб»
belly = 0.2
deltoid = 0.75
muscle = 0.7
shoulders = 0.7
stature = 1.72
torso-depth = 0.1
weight = 0.35

[archetype]
id = khansha
name_key = chargen.archetype.kaysaki.khansha
frequency = 12
# лор: «статная, прямая»
buttocks = 0.3
hips = 0.35
muscle = 0
stature = 1.76
weight = 0

[archetype]
id = salt-cutter
name_key = chargen.archetype.kaysaki.salt-cutter
frequency = 8
# лор: «кряжистый, белёсый от соли»
muscle = 0.45
shoulders = 0.45
stature = 1.7
weight = 0.1

[archetype]
id = bard
name_key = chargen.archetype.kaysaki.bard
frequency = 7
# лор: «худой, огромные кисти»
age = 0.45
arm-length = 0.5
muscle = -0.1
weight = -0.75

[archetype]
id = shaman
name_key = chargen.archetype.kaysaki.shaman
frequency = 8
# лор: «сухой, асимметричный»
age = 0.4
deltoid = -0.35
muscle = -0.15
weight = -0.7

# --- ИМЯ -------------------------------------------------------------------
[naming]
rule_key = chargen.naming.kaysaki

