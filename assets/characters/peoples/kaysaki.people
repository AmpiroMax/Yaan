# --- ПАЛИТРЫ (ДАННЫМИ ВПРОК) -----------------------------------------------
# ПОТРЕБИТЕЛЯ У ЭТИХ ТРЁХ СЕКЦИЙ СЕГОДНЯ НЕТ, и это сказано вслух, а не
# обнаружится на середине следующей волны: тело красится одной константой
# CHARGEN_CLAY, у него нет ни текстуры, ни материала. Фаза Ф3 (кожа, волосы,
# глаза) ЗАБЛОКИРОВАНА зоной МАТЕРИАЛЫ (CHARGEN_UI.md). Веса лежат здесь
# готовыми, чтобы разблокировка была правкой экрана, а не второй лор-сессией.
# Ключей локализации у оттенков нет по той же причине — их некому показывать;
# слово лороведа стоит в комментарии строки.

# КОЖА. Сумма весов — 100.
[skin]
swarthy = 55  # смуглая
bronze = 30  # бронзовая от солнца
light-swarthy = 15  # светло-смуглая

# ВОЛОСЫ. Сумма весов — 100.
[hair]
black = 75  # чёрные
dark-chestnut = 18  # тёмно-каштановые
early-grey = 5  # седые пряди смолоду
red = 2  # рыжие — «отмечен огнём»

# ГЛАЗА. Сумма весов — 100.
[eyes]
brown = 60  # карие
black = 20  # чёрные
green = 12  # зелёные
grey = 8  # серые

# --- ОТМЕТИНЫ (ДАННЫМИ ВПРОК) ----------------------------------------------
# ТОТ ЖЕ ХВОСТ: отметина — это ДЕКАЛЬ, то есть второй слой текстуры, то есть
# материал. Потребителя нет. Формат строки:
#   <знак> = <частота, %> <место> [<типажи через запятую>]
# Частота 0 значит «частоту назначает не народ»: маркер на ткани или на вещи.
[marks]
tamga = 90 left-forearm  # ЗНАК РОДА, выжженный или наколотый, у всех взрослых — ЛОРОМ НАЗВАНЫ 90 % и 12-16 вариантов знаков по родам
henna = 40 hands khansha  # узоры хной к празднику — ЛОРОМ НАЗВАНЫ 40 % в толпе Курганлы в сезон
brow-scar = 25 brow rider,wrestler  # белая полоса «метка первой сшибки» — ЛОРОМ НАЗВАНЫ 25 %
