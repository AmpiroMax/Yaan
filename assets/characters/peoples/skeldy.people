# Daggerfall N — НАРОД: СКЕЛЬДЫ — норвежский север, народ фьордов и конунгств.
#
# ЭТО РАСПРЕДЕЛЕНИЕ, А НЕ ТОЧКА (CHARGEN_UI.md, Р8). Народ несёт для каждой
# ручки края [lo, hi], типаж — центр μ внутри них, а «Случайно» бросает
# УСЕЧЁННУЮ НОРМАЛЬ. Игроку файл даёт стартовую точку и сужает нарисованную
# дорожку; толпе — выборку. Один файл, два потребителя.
#
# ОТКУДА ЧИСЛА. Края СУДЕЙСКИЕ (секция MORF у HumanBase.dfo, измерены
# приёмкой шага 1) народ только СУЖАЕТ — выйти за них он не вправе, и
# читатель отказывает громко. Что именно сужено и почему — в [limits].
# Слова — из docs/story/PEOPLES_CHARGEN.md (сдача лороведа); ЧИСЛА полос и
# типажей — ПРЕДЛОЖЕНИЕ этой волны по тем словам, требует утверждения.
#
# ИМЕНА ПЕРЕНЕСЕНЫ ИЗ ДОКУМЕНТА МЕХАНИЧЕСКИ, все 120: 480 собственных имён
# руками не переносят — переносят с опечаткой, а имя народа с опечаткой
# нельзя ни увидеть, ни проверить.
#
# ЧЕГО У ЭТОГО НАРОДА НЕ БЫВАЕТ (лор, дословно):
#   — смуглой и оливковой кожи.
#   — чёрных глаз.
#   — чёрных волос (кроме 2 % «вороньей пряди»).
#   — низкорослой коренастости юга.
#   — хны и красок на коже.

id = skeldy
order = 2
name_key = chargen.people.skeldy
blurb_key = chargen.people.skeldy.blurb

# --- КРАЯ НАРОДА -----------------------------------------------------------
# <ручка> = <lo> <hi>. Обязаны лежать ВНУТРИ судейской полосы; шире — отказ
# при чтении, а не молчаливое обрезание.
[limits]
# ПРАВИЛО МОЛЧАНИЯ: ручка, НЕ НАЗВАННАЯ здесь, берёт судейскую полосу
# ЦЕЛИКОМ. Повторять её числа рядом с комментарием «лор её не сужает» нельзя:
# повторённое число — копия, и она разошлась с оригиналом на первой же
# перепечке целей MORF (судья сузил belly с 0.45 до 0.43, и два народа были
# отвергнуты за полосу ШИРЕ судейской, которую никто не расширял).
arm-length = -0.3 1
belly = 0 0.35  # рыбий стол: оплывших мало
buttocks = -0.8 0.7
deltoid = -0.4 1
hips = -0.72 0.6  # узче венедов в тазу; низ усечён судьёй: полоса начинается на -0.72 (рест-поза «по швам» 02.09)
leg-length = -0.4 1  # длинноногие: низ полосы поднят
muscle = -0.2 1
shoulders = -0.2 1
stature = 1.72 1.84  # лор: «низкорослой коренастости юга не бывает» — низ полосы поднят
torso-depth = -0.6 0.25
weight = -0.55 0.55

# --- ТИПАЖИ ----------------------------------------------------------------
# frequency — вес выборки, в процентах; сумма восьми обязана быть 100.
# Названы ТОЛЬКО те ручки, о которых лор сказал словами. Неназванная ручка
# берёт центр народа и σ = (hi−lo)/4 — то есть «про эту ручку типаж молчит»,
# а не «эта ручка у него ноль».

[archetype]
id = whaler
name_key = chargen.archetype.skeldy.whaler
frequency = 20
# лор: «плечистый, шея быка»
deltoid = 0.8
muscle = 0.55
shoulders = 0.8
torso-depth = 0.1
weight = 0.25

[archetype]
id = fisher
name_key = chargen.archetype.skeldy.fisher
frequency = 18
# лор: «жилистый, кисти-клешни»
arm-length = 0.55
muscle = 0.5
weight = -0.3

[archetype]
id = helmsman
name_key = chargen.archetype.skeldy.helmsman
frequency = 12
# лор: «сухой, прищуренный»
age = 0.3
muscle = 0.2
weight = -0.35

[archetype]
id = ice-hunter
name_key = chargen.archetype.skeldy.ice-hunter
frequency = 12
# лор: «поджарый, лёгкий»
belly = 0.02
leg-length = 0.55
muscle = 0.3
weight = -0.45

[archetype]
id = fjord-mistress
name_key = chargen.archetype.skeldy.fjord-mistress
frequency = 15
# лор: «высокая, прямая спина»
age = 0.1
buttocks = 0.3
hips = 0.25
stature = 1.8
weight = 0

[archetype]
id = skald
name_key = chargen.archetype.skeldy.skald
frequency = 8
# лор: «худой, длиннопалый»
arm-length = 0.65
muscle = -0.15
shoulders = -0.1
weight = -0.5

[archetype]
id = housecarl
name_key = chargen.archetype.skeldy.housecarl
frequency = 10
# лор: «рослый, тяжёлый»
deltoid = 0.7
muscle = 0.7
shoulders = 0.7
stature = 1.82
weight = 0.3

[archetype]
id = elder
name_key = chargen.archetype.skeldy.elder
frequency = 5
# лор: «согнутый, но широкая кость»
age = 0.52
hips = 0.35
shoulders = 0.4
stature = 1.74
weight = 0.1

# --- ИМЯ -------------------------------------------------------------------
[naming]
rule_key = chargen.naming.skeldy
patronym_male = сон
patronym_female = доттер
patronym_share = 50  # ПРЕДЛОЖЕНИЕ: лор говорит, что патронимы есть
                     # наравне с клановыми, но доли не называет

