# Daggerfall N — НАРОД: ВЕНЕДЫ — славянский центр, народ-хребет империи.
#
# ЭТО РАСПРЕДЕЛЕНИЕ, А НЕ ТОЧКА (CHARGEN_UI.md, Р8). Народ несёт для каждой
# ручки края [lo, hi], типаж — центр μ внутри них, а «Случайно» бросает
# УСЕЧЁННУЮ НОРМАЛЬ. Игроку файл даёт стартовую точку и сужает нарисованную
# дорожку; толпе — выборку. Один файл, два потребителя.
#
# ОТКУДА ЧИСЛА. Края СУДЕЙСКИЕ (секция MORF у HumanBase.dfo, измерены
# приёмкой шага 1) народ только СУЖАЕТ — выйти за них он не вправе, и
# читатель отказывает громко. Что именно сужено и почему — в [limits].
# Слова — из docs/story/PEOPLES_CHARGEN.md (сдача лороведа); ЧИСЛА полос и
# типажей — ПРЕДЛОЖЕНИЕ этой волны по тем словам, требует утверждения.
#
# ИМЕНА ПЕРЕНЕСЕНЫ ИЗ ДОКУМЕНТА МЕХАНИЧЕСКИ, все 120: 480 собственных имён
# руками не переносят — переносят с опечаткой, а имя народа с опечаткой
# нельзя ни увидеть, ни проверить.
#
# РАСХОЖДЕНИЕ ЛОРА И СУДЬИ, РАЗРЕШЁННОЕ В ПОЛЬЗУ СУДЬИ И ЗАПИСАННОЕ
# ЗДЕСЬ, А НЕ ЗАМОЛЧАННОЕ. Лоровед назвал предел НАРОДА, судья мерил
# КАНОН ПРОПОРЦИЙ, и разошлись они не по чьей-то ошибке:
#   — рост, низ: лор 1.50 м, судья 1.66 м -> взято 1.66.
#   — рост, верх: лор 2.00 м, судья 1.84 м -> взято 1.84.
# ЛОР НЕ ПЕРЕПИСАН. Это полоса РОСТА уже лора, а не лор шире правды:
# ход ползунка роста ограничен капсулой игрока и каноном 7.5-8.0 голов,
# и расширять его — тикет капсулы, а не правка этого файла.
#
# ЧЕГО У ЭТОГО НАРОДА НЕ БЫВАЕТ (лор, дословно):
#   — иссиня-чёрной и оливково-южной кожи.
#   — платиновых и пепельно-белых волос (только седина).
#   — миндалевидного разреза степи.
#   — роста ниже 150 и выше 200.
#   — синих татуировок по лицу.

id = venedy
order = 1
name_key = chargen.people.venedy
blurb_key = chargen.people.venedy.blurb

# --- КРАЯ НАРОДА -----------------------------------------------------------
# <ручка> = <lo> <hi>. Обязаны лежать ВНУТРИ судейской полосы; шире — отказ
# при чтении, а не молчаливое обрезание.
[limits]
# ПРАВИЛО МОЛЧАНИЯ: ручка, НЕ НАЗВАННАЯ здесь, берёт судейскую полосу
# ЦЕЛИКОМ. Повторять её числа рядом с комментарием «лор её не сужает» нельзя:
# повторённое число — копия, и она разошлась с оригиналом на первой же
# перепечке целей MORF (судья сузил belly с 0.45 до 0.43, и два народа были
# отвергнуты за полосу ШИРЕ судейской, которую никто не расширял).
arm-length = -0.45 0.8
buttocks = -0.6 1
deltoid = -0.55 0.9
hips = -0.2 0.85  # НИЗ ЛОРНЫЙ («широкая кость», узкобёдрых почти нет), ВЕРХ УСЕЧЁН СУДЬЁЙ: лор верх не сужал вовсе, судейская полоса кончается на 0.85
leg-length = -0.75 0.6  # коренастее фьордов: длинных ног нет
muscle = -0.3 0.85
shoulders = -0.35 1  # «широкая кость» — узкоплечих почти нет
stature = 1.66 1.84  # УСЕЧЕНО СУДЬЁЙ: лор назвал 150-200 см, судейская полоса 1.66-1.84 уже с обоих концов
torso-depth = -0.5 0.25
weight = -0.45 0.65  # хлебопашцы: совсем сухих не бывает

# --- ТИПАЖИ ----------------------------------------------------------------
# frequency — вес выборки, в процентах; сумма восьми обязана быть 100.
# Названы ТОЛЬКО те ручки, о которых лор сказал словами. Неназванная ручка
# берёт центр народа и σ = (hi−lo)/4 — то есть «про эту ручку типаж молчит»,
# а не «эта ручка у него ноль».

[archetype]
id = plowman
name_key = chargen.archetype.venedy.plowman
frequency = 25
# лор: «широкая кость, покатые плечи»
deltoid = -0.25
hips = 0.55
shoulders = 0.1
weight = 0.15

[archetype]
id = raftsman
name_key = chargen.archetype.venedy.raftsman
frequency = 15
# лор: «жилистый, длиннорукий»
arm-length = 0.55
belly = 0.05
muscle = 0.45
weight = -0.2

[archetype]
id = smith
name_key = chargen.archetype.venedy.smith
frequency = 10
# лор: «кряжистый, тяжёлый верх»
deltoid = 0.75
leg-length = -0.4
muscle = 0.7
shoulders = 0.7
torso-depth = 0.1
weight = 0.25

[archetype]
id = fisher
name_key = chargen.archetype.venedy.fisher
frequency = 12
# лор: «сухой, обветренный»
belly = 0.02
muscle = 0.2
torso-depth = -0.25
weight = -0.35

[archetype]
id = goodwife
name_key = chargen.archetype.venedy.goodwife
frequency = 15
# лор: «крепкая, широкая в кости»
buttocks = 0.55
deltoid = -0.3
hips = 0.7
shoulders = 0.05
weight = 0.3

[archetype]
id = scribe
name_key = chargen.archetype.venedy.scribe
frequency = 8
# лор: «узкоплечий, сутулый»
age = 0.3
deltoid = -0.5
muscle = -0.25
shoulders = -0.3
weight = -0.1

[archetype]
id = recruit
name_key = chargen.archetype.venedy.recruit
frequency = 10
# лор: «подтянутый, стоптанный»
belly = 0.02
muscle = 0.5
shoulders = 0.35
weight = -0.05

[archetype]
id = healer
name_key = chargen.archetype.venedy.healer
frequency = 5
# лор: «сухой, узловатые руки»
age = 0.45
arm-length = 0.25
muscle = -0.1
weight = -0.4

# --- ИМЯ -------------------------------------------------------------------
[naming]
rule_key = chargen.naming.venedy

