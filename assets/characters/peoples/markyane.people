# Daggerfall N — НАРОД: МАРКЯНЕ — прусско-немецкий запад, народ гор, цехов и застав.
#
# ЭТО РАСПРЕДЕЛЕНИЕ, А НЕ ТОЧКА (CHARGEN_UI.md, Р8). Народ несёт для каждой
# ручки края [lo, hi], типаж — центр μ внутри них, а «Случайно» бросает
# УСЕЧЁННУЮ НОРМАЛЬ. Игроку файл даёт стартовую точку и сужает нарисованную
# дорожку; толпе — выборку. Один файл, два потребителя.
#
# ОТКУДА ЧИСЛА. Края СУДЕЙСКИЕ (секция MORF у HumanBase.dfo, измерены
# приёмкой шага 1) народ только СУЖАЕТ — выйти за них он не вправе, и
# читатель отказывает громко. Что именно сужено и почему — в [limits].
# Слова — из docs/story/PEOPLES_CHARGEN.md (сдача лороведа); ЧИСЛА полос и
# типажей — ПРЕДЛОЖЕНИЕ этой волны по тем словам, требует утверждения.
#
# ИМЕНА ПЕРЕНЕСЕНЫ ИЗ ДОКУМЕНТА МЕХАНИЧЕСКИ, все 120: 480 собственных имён
# руками не переносят — переносят с опечаткой, а имя народа с опечаткой
# нельзя ни увидеть, ни проверить.
#
# ЧЕГО У ЭТОГО НАРОДА НЕ БЫВАЕТ (лор, дословно):
#   — смуглой южной кожи.
#   — племенных узоров на коже.
#   — кос ниже пояса у мужчин.
#   — имён без фамилий у горожан.

id = markyane
order = 3
name_key = chargen.people.markyane
blurb_key = chargen.people.markyane.blurb

# --- КРАЯ НАРОДА -----------------------------------------------------------
# <ручка> = <lo> <hi>. Обязаны лежать ВНУТРИ судейской полосы; шире — отказ
# при чтении, а не молчаливое обрезание.
[limits]
age = 0 0.55  # вся судейская полоса: лор её не сужает
arm-length = -0.65 0.6  # рука короче венедской
belly = 0 0.45  # вся судейская полоса: лор её не сужает
buttocks = -0.7 0.8
deltoid = -0.5 1
hips = -0.4 0.85
leg-length = -1 0.45  # горная коренастость: длинных ног нет вовсе
muscle = -0.35 0.9
shoulders = -0.4 0.9
stature = 1.66 1.8  # рослых как скельды не бывает — верх подрезан
torso-depth = -0.45 0.25
weight = -0.45 0.65  # горожане цехов: истощённых нет, а студент — самый сухой из них

# --- ТИПАЖИ ----------------------------------------------------------------
# frequency — вес выборки, в процентах; сумма восьми обязана быть 100.
# Названы ТОЛЬКО те ручки, о которых лор сказал словами. Неназванная ручка
# берёт центр народа и σ = (hi−lo)/4 — то есть «про эту ручку типаж молчит»,
# а не «эта ручка у него ноль».

[archetype]
id = miner
name_key = chargen.archetype.markyane.miner
frequency = 22
# лор: «коренастый, мощная спина»
leg-length = -0.55
muscle = 0.55
shoulders = 0.6
stature = 1.7
torso-depth = 0.15
weight = 0.2

[archetype]
id = armourer
name_key = chargen.archetype.markyane.armourer
frequency = 12
# лор: «кряжистый, предплечья-брёвна»
arm-length = -0.1
deltoid = 0.8
muscle = 0.75
shoulders = 0.6
weight = 0.3

[archetype]
id = guildmaster
name_key = chargen.archetype.markyane.guildmaster
frequency = 15
# лор: «плотный, брюшко»
age = 0.35
belly = 0.35
muscle = -0.1
weight = 0.5

[archetype]
id = warden
name_key = chargen.archetype.markyane.warden
frequency = 12
# лор: «рослый, прямой»
belly = 0.03
muscle = 0.4
shoulders = 0.45
stature = 1.78

[archetype]
id = innkeeper
name_key = chargen.archetype.markyane.innkeeper
frequency = 12
# лор: «крепкая, круглолицая»
buttocks = 0.5
hips = 0.55
muscle = -0.05
weight = 0.45

[archetype]
id = clerk
name_key = chargen.archetype.markyane.clerk
frequency = 10
# лор: «сухой, чернильные пальцы»
age = 0.35
muscle = -0.3
shoulders = -0.3
weight = -0.25

[archetype]
id = guide
name_key = chargen.archetype.markyane.guide
frequency = 9
# лор: «поджарый, кривоногий»
hips = 0.1
leg-length = -0.3
muscle = 0.45
weight = -0.35

[archetype]
id = student
name_key = chargen.archetype.markyane.student
frequency = 8
# лор: «тонкий, быстрый»
age = 0.02
muscle = 0.1
shoulders = -0.15
stature = 1.75
weight = -0.4

# --- ИМЯ -------------------------------------------------------------------
[naming]
rule_key = chargen.naming.markyane

