# Daggerfall N scene — ЧИСТЫЙ ЛАНДШАФТ ПОД ГОРОД (зона домов, задача B).
# Свой небольшой стенд по правилу пользователя («стенды делать — отдельные
# небольшие карты»): Gallery, 1 чанк = 256 м, ничего из обзорного мира.
# ВЕСЬ рельеф — композицией: холм тремя полками [pad] (числа из
# docs/WHITERUN_RESEARCH.md: перепады 6 и 12 м), река — [river] (два рукава:
# городской ЧЕРЕЗ нижнюю террасу и стенной РВОМ вдоль юго-восточного
# подножия, где встанет стена; развилка до города, слияние на юге).
#
# Отметки согласованы с натуральной землёй Gallery (26.9 на СЗ -> 24.3 на ЮВ,
# мерено dfn_scene_check --ground):
#   полка T1 25.0 (набережная над водой города ~1.5 м), T2 31.0 (+6),
#   T3 43.0 (+12); вода падает монотонно 24.2 -> 22.4.
# ЛИНИЯ СТЕНЫ (для лида, объектов здесь нет): пояс между кромками T1/T2 и
# стенным рукавом, отступ ~10 м от уреза — рукав работает рвом.
map = houses/town-land
world_span_m = 256
spawn = 128 0 236
spawn_yaw = 0

[pad]
center = 116 158
half_extents = 60 40
blend = 14
height = 25.0
note = T1 нижняя терраса: ворота, кузница, рынок; городской рукав идёт через неё

[pad]
center = 118 84
half_extents = 50 35
blend = 12
height = 31.0
note = T2 средняя: жилые дома, храм (перепад +6 от T1)

[pad]
center = 196 32
half_extents = 26 16
blend = 10
height = 43.0
note = T3 верхняя: только замок, отдельным языком (+12 от T2)

[pad]
center = 172 54
half_extents = 10 10
blend = 6
height = 37.0
note = перешеек-лестница к замку, единственный вход на T3

[river]
width_m = 6
depth_m = 0.8
bank_m = 7
note = верховье: входит с севера восточнее замковой скалы, идёт вдоль восточного края
point = 242 4 24.2
point = 238 40 24.0
point = 234 84 23.8
point = 230 104 23.7

[river]
width_m = 5
depth_m = 0.8
bank_m = 6
note = городской рукав: от развилки (230,104) через T1 по диагонали СВ-ЮЗ, набережные ~1.5 м, дальше вниз к слиянию
point = 230 104 23.7
point = 196 124 23.6
point = 160 144 23.5
point = 120 166 23.4
point = 84 186 23.3
point = 88 214 23.0
point = 108 232 22.8
point = 140 242 22.6

[river]
width_m = 7
depth_m = 1.0
bank_m = 8
note = стенной рукав: ров вдоль юго-восточного подножия, стена встаёт между ним и полками
point = 230 104 23.7
point = 234 140 23.4
point = 226 176 23.1
point = 204 206 22.9
point = 172 228 22.7
point = 140 242 22.6

[river]
width_m = 9
depth_m = 1.2
bank_m = 9
note = низовье после слияния, уходит с карты на юг
point = 140 242 22.6
point = 128 254 22.4
