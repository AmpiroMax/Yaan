# ПЛОЩАДКА ГОРОДА — СВОЙ НЕБОЛЬШОЙ СТЕНД, а не кусок обзорного мира.
#
# Пользователь 17.08: «надо стенды делать — отдельные небольшие карты... вот
# флора правильно всё делал». Первая версия этой демки стояла на stand:Testbed
# и тащила за собой скалу, замок, подземелья и 512 м пролёта — то есть проверяла
# инструмент на чужом мире вместо своего. Здесь ВСЁ, что есть на карте, кладёт
# КОМПОЗИЦИЯ: спокойная земля стенда, три полки секцией [pad], река секцией
# [river]. Ничего не найдено в готовом рельефе — всё положено.
#
# Земля стенда ~25.7 м, поэтому отметки полок и воды считаны ОТ НЕЁ.
# Проверить:
#   dfn_scene_check assets/scenes/town-site.scene --ground 128 96 40 --stand Gallery
#   dfn_scene_check - --ground 128 96 40 --stand Gallery        (натуральная)
map = landscape/town-site
world_span_m = 256
spawn = 128 0 214
spawn_yaw = 0

[pad]
center = 120 96
half_extents = 58 34
blend = 12
height = 27.5
note = T1 нижняя: ворота, кузница, рынок, таверна. Отметка 27.5 при воде городского рукава 26.2 — набережная по пояс, к которой человек наклоняется за водой

[pad]
center = 136 56
half_extents = 44 24
blend = 10
height = 32
note = T2 средняя: жилые дома, храм, зал. Смещена к подъёму, не концентрична нижней

