# Daggerfall N — ИСПОРЧЕННЫЙ ИНТЕРЬЕР. ПРИЁМОЧНАЯ ОСНАСТКА, НЕ КОНТЕНТ.
#
# Эта локация НЕ ПРИНАДЛЕЖИТ НИ ОДНОМУ ГОРОДУ и никогда не будет открыта
# игроком: на неё не ссылается ни один interior=. Она существует затем, что
# у рук 1/2/5/7 приёмки И15 на верной локации ТОЛЬКО ОТРИЦАТЕЛЬНОЕ ПЛЕЧО —
# находок ноль по построению, — а молчание прибора неотличимо от прибора
# неработающего (свод, дельта-5). Здесь заложены РОВНО ЧЕТЫРЕ дефекта, по
# одному на руку, и приёмка обязана назвать все четыре и НИ ОДНОГО СВЕРХ:
#
#   ДЕФЕКТ 1 (рука 1): четыре полки в ряд поперёк комнаты, от стены до
#       стены (щели 0.03 и 0.03 м при капсуле 0.70). За барьером стоит
#       РОВНО ОДИН предмет — стол, — и он обязан оказаться недостижимым.
#       БАРЬЕР ИЗ ПОЛОК, А НЕ ИЗ КРОВАТЕЙ, И ЭТО ЗАМЕР, А НЕ ВКУС. Свод
#       называл дефектом «кровать поперёк прохода»; кровать этого набора —
#       матрас высотой 0.42 м (ниже шага игрока 0.45) и ЧЕТЫРЕ СТОЛБИКА по
#       углам с просветом 0.64 м между ними. По ней ходят, а не упираются:
#       ряд из двух кроватей приборы прошли насквозь, и правы были они.
#       Находка для волны Б: «мебель поперёк прохода» — свойство ВЫСОТЫ и
#       СПЛОШНОСТИ предмета, а не его назначения.
#   ДЕФЕКТ 2 (рука 2): бочка вкопана в пол на полметра (pos.y = 0.12 - 0.50).
#       Прибор называет 0.52: он мерит от ДОСКИ ПОД БОЧКОЙ (0.14), а не от
#       номинальной отметки пола, — и это правильно, потому что предмет
#       стоит на доске, а не на отметке.
#   ДЕФЕКТ 3 (рука 5): обратный переход стоит ЗА СТЕНОЙ, на x = 5.60 —
#       снаружи оболочки. Войти можно, выйти нельзя.
#   ДЕФЕКТ 4 (рука 7): девять настоящих [light] при бюджете восемь.
#
# ПРАВИТЬ ТОЛЬКО ВМЕСТЕ С ПРИБОРОМ. Пятая находка здесь — это не «стало
# хуже», это прибор, который меряет не то; ровно так же и третья.
map = int/broken
world_span_m = 64

[spawn]
name = door
pos = 2.250 0.200 5.200
yaw = 0
note = сразу за порогом, лицом в комнату

[house]
file = assets/houses/city-house-s-portal.dfh
pos = 0 0 0
yaw = 0
note = оболочка: тот же чертёж, что у пилота

# ---- ДЕФЕКТ 1: барьер поперёк прохода ----
[house]
file = assets/houses/furn-shelf.dfh
pos = 0.100 0.120 2.600
yaw = 0
note = полка поперёк прохода (1 из 4)

[house]
file = assets/houses/furn-shelf.dfh
pos = 1.200 0.120 2.600
yaw = 0
note = полка поперёк прохода (2 из 4)

[house]
file = assets/houses/furn-shelf.dfh
pos = 2.300 0.120 2.600
yaw = 0
note = полка поперёк прохода (3 из 4)

[house]
file = assets/houses/furn-shelf.dfh
pos = 3.200 0.120 2.600
yaw = 0
note = полка поперёк прохода (4 из 4)

# ЕДИНСТВЕННЫЙ предмет за барьером: его недостижимость и есть находка руки 1.
[house]
file = assets/houses/furn-table.dfh
pos = 1.000 0.120 1.000
yaw = 0
note = стол за барьером — до него не дойти

# ---- ДЕФЕКТ 2: бочка в полу на полметра ----
[house]
file = assets/houses/furn-barrel.dfh
pos = 3.600 -0.380 4.600
yaw = 0
note = бочка вкопана в пол на 0.50 м

# ---- ДЕФЕКТ 4: девять огней при бюджете восемь ----
[light]
pos = 1.000 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 1

[light]
pos = 1.500 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 2

[light]
pos = 2.000 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 3

[light]
pos = 2.500 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 4

[light]
pos = 3.000 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 5

[light]
pos = 3.500 1.200 4.800
color = 1 0.8 0.5
radius_m = 4
note = огонь 6

[light]
pos = 1.000 1.200 5.300
color = 1 0.8 0.5
radius_m = 4
note = огонь 7

[light]
pos = 1.500 1.200 5.300
color = 1 0.8 0.5
radius_m = 4
note = огонь 8

[light]
pos = 2.000 1.200 5.300
color = 1 0.8 0.5
radius_m = 4
note = огонь 9 — девятый, и он лишний

[air]
fog_start = 40
fog_end = 120
ambient = 0.10

# ---- ДЕФЕКТ 3: обратный переход за стеной ----
[portal]
at = 5.600 1.000 3.000
radius_m = 1.1
to = ^back
note = обратная дверь ЗА СТЕНОЙ — выйти нельзя
