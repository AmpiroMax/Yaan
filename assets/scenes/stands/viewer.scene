# Daggerfall N — СМОТРОВАЯ (композиция площадки).
#
# ЗДЕСЬ НАРОЧНО НЕТ НИ ОДНОГО [place]. Композиция существует ради двух вещей:
#   1) она гасит АВТО-ГРИД галереи (карта с composed-сценой не получает вторую,
#      непрошеную шеренгу всей полки), и постамент остаётся пустым до тех пор,
#      пока на него не поставят модель клавишей;
#   2) она задаёт ровный настил и портретный свет — то есть ту часть кадра,
#      которая обязана быть ОДИНАКОВОЙ для всех моделей. Свет, меняющийся от
#      модели к модели, превратил бы «две модели рядом» в сравнение двух
#      освещений.
#
# ЕДИНСТВЕННЫЙ ПРЕДМЕТ КАДРА — САМА МОДЕЛЬ. Никаких лавок, домов и деревьев:
# они дали бы масштабный ориентир, но и заслоняли бы модель ростом с них, а
# размер здесь называет ПОДПИСЬ, и называет числом.
map = stands/viewer
world_span_m = 256

# СПАВН — В ДВАДЦАТИ ПЯТИ МЕТРАХ ОТ ПОСТАМЕНТА, лицом к нему. Камера смотровой
# отвязана от тела и облетает постамент, а тело всё равно где-то стоит; на
# постаменте оно стояло бы ВНУТРИ показываемой модели. Двадцать пять метров —
# это дальше самого дальнего отхода камеры у любой модели дерева.
spawn = 128.000 0 153.000
spawn_yaw = 0.000

# --- НАСТИЛ -------------------------------------------------------------
# Один прямоугольник на всю рабочую зону, отметка 25.5 — та же, что у стенда
# персонажа, чтобы рецепты приёмки двух стендов говорили об одной высоте.
# Кайма blend = 8: за краем настила земля уходит вниз плавно, и в кадре, снятом
# от земли, за моделью не встаёт обрыв.
[pad]
center = 128 132
half_extents = 26 26
blend = 8
height = 25.500
note = ровный настил смотровой: постамент в его середине (128, 128)

# --- ПОРТРЕТНЫЙ СВЕТ ----------------------------------------------------
# Три источника, как ставят свет на портрете, и ни один из них не мигает
# (flicker = 0): кадр приёмки обязан быть сравним сам с собой.
#
#   РИСУЮЩИЙ — спереди-слева и выше головы, тёплый и самый сильный. Он лепит
#   форму: одна его сторона у модели светлая, другая уходит в тень.
#   ЗАПОЛНЯЮЩИЙ — справа, холоднее и вдвое слабее. Он не убирает тень, а
#   поднимает её со дна, иначе теневая половина модели становится силуэтом.
#   КОНТРОВОЙ — сзади и высоко. Он обводит модель по краю и отделяет её от
#   земли; без него тёмная модель на тёмном настиле читается как пятно.
#
# ВЫСОТЫ ДАНЫ ОТ ОТМЕТКИ НАСТИЛА (25.5): 2.4 / 1.9 / 3.2 метра над ним. Радиусы
# заведомо больше самой большой модели, которую сюда можно поставить, — иначе
# крупная модель выходила бы из освещённого пузыря и темнела сверху.
#
# ЯРКОСТИ ПОНИЖЕНЫ ПОСЛЕ ПЕРВОГО ПРИЁМОЧНОГО КАДРА, и это находка, а не вкус:
# лампы стенда СКЛАДЫВАЮТСЯ С СОЛНЦЕМ, а не заменяют его, и при исходных
# единичных яркостях светлая модель выходила белым силуэтом без единой складки.
# Стенд показывает ФОРМУ, форма читается затенением, а затенению нужно место.
[light]
pos = 125.400 27.900 125.000
color = 0.52 0.49 0.44
radius_m = 18.0
casts_shadow = 1
softness = 0.65
flicker = 0.0
note = рисующий: спереди-слева, выше головы, тёплый

[light]
pos = 131.200 27.400 126.400
color = 0.20 0.22 0.27
radius_m = 16.0
casts_shadow = 0
softness = 0.85
flicker = 0.0
note = заполняющий: справа, холодный, вдвое слабее — поднимает тень со дна

[light]
pos = 128.000 28.700 131.400
color = 0.30 0.31 0.34
radius_m = 16.0
casts_shadow = 0
softness = 0.50
flicker = 0.0
note = контровой: сзади и высоко — обводка по краю, отделяет модель от настила

# --- ВОЗДУХ: РОВНЫЙ РАССЕЯННЫЙ СВЕТ -------------------------------------
# Сплошная облачность — это не погода стенда, а его СОФТБОКС: под ней солнце
# не бьёт с одной стороны, тени мягкие, и модель читается одинаково с любого
# азимута облёта. Без неё кадр модели зависел бы от того, куда её повернули
# относительно солнца, то есть два кадра одной модели были бы несравнимы.
#
# Дымка отодвинута далеко: постамент стоит в трёх метрах от глаза, и всё, что
# ближе горизонта, обязано доехать до кадра неразмытым.
[air]
fog_start = 400
fog_end = 900
cloud = 0.95
ambient = 0.42
