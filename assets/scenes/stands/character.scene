# Daggerfall N — СТЕНД ПЕРСОНАЖА.
#
# ЧТО ЗДЕСЬ ЕСТЬ И ЗАЧЕМ КАЖДОЕ. Стенд не декорация: каждый предмет — мерило
# одного утверждения о фигуре.
#   ровная площадка  — шаг и скольжение ноги меряются на плоскости, иначе в
#                      разницу двух рук попадает рельеф;
#   лавка 0.45       — поза «сидеть» (Sitting_Idle_Loop и процедурная посадка);
#   кровать 0.50     — поза «лежать»: клипа для неё у ассета НЕТ, и стенд
#                      существует в том числе чтобы это было видно;
#   дом с дверью     — рост фигуры против дверного проёма, и вход внутрь;
#   марш 0.18/0.28   — канон HUMAN_SCALE: попадает ли нога на ступень;
#   склон            — подъём, на котором видно, что стопа не втыкается в
#                      землю и не висит над ней.
#
# БОЕВЫЕ КАРТЫ ЭТОЙ ВОЛНОЙ НЕ ТРОНУТЫ НИ БАЙТОМ.
map = stands/character
world_span_m = 256

# СПАВН — ОН ЖЕ ТОЧКА КАДРА. Фигура стоит на середине настила лицом к лавке и
# к дому; заданная очередь (DFN_STAND_SEQ=1) уводит её вперёд по площадке и
# возвращает к лавке к моменту посадки.
spawn = 129.200 0 136.000
spawn_yaw = 0.000

# --- ПЛОЩАДКА -----------------------------------------------------------
# Прямоугольник 40 x 28 на отметке 25.5. Кайма blend = 6: она же и есть
# СКЛОН стенда — площадка встречает окрестный рельеф скатом, и по нему ходят.
[pad]
center = 128 130
half_extents = 20 14
blend = 6
height = 25.500
note = ровный настил: на нём меряются шаг и скольжение ноги

# ВТОРАЯ ПЛОЩАДКА НА 1.6 м ВЫШЕ, вплотную к первой: между ними кайма делает
# скат примерно 15 градусов длиной около 6 м. Склон — НЕ отдельный предмет, а
# граница двух отметок, потому что именно так склон устроен в мире.
[pad]
center = 128 108
half_extents = 12 8
blend = 6
height = 27.100
note = верхняя терраса: скат между отметками и есть склон стенда

# --- ЛАВКА И КРОВАТЬ ----------------------------------------------------
# Оба чертежами [house], а не ссылками [place]: точки посадки собираются по
# ЧЕРТЕЖУ (FurnitureSeats.h), и лавка-картинка сидеть не даст.
[house]
file = assets/houses/furn-bench.dfh
pos = 130.200 25.500 136.400
yaw = 1.570796
note = лавка: настил 0.45 — поза «сидеть»

[house]
file = assets/houses/furn-bed.dfh
pos = 133.400 25.500 136.400
yaw = 1.570796
note = кровать: матрас 0.50 — поза «лежать» (клипа у ассета нет, и это видно)

# --- ДВЕРЬ: РОСТ ФИГУРЫ ПРОТИВ ПРОЁМА -----------------------------------
[house]
file = assets/houses/city-house-s.dfh
pos = 122.000 25.500 122.000
yaw = 0
note = дом малой формы: его дверь — мерило роста, и в неё входят

# --- КАНОНИЧЕСКИЙ МАРШ 0.18 / 0.28 --------------------------------------
# Стоит у подножия верхней террасы и ведёт на неё: 6 x 0.18 = 1.08 при её
# подъёме 1.6 — марш НЕ дотягивает до верха нарочно, чтобы на одном кадре
# были и ступени, и скат.
[house]
file = assets/houses/stand-steps6-h108.dfh
pos = 126.000 25.500 118.000
yaw = 1.570796
note = шесть ступеней канона: подступёнок 0.18, проступь 0.28

# --- ЯЩИК: СТОПЫ НА ПРЕДМЕТЕ, А НЕ НА ЗЕМЛЕ -----------------------------
# Заказ владельца 31.08, пункт 3: «стоя на объекте одна стопа парит». До этой
# волны стенд мерил стопу только против ЗЕМЛИ; кровать рядом на это не годится
# — её матрас на 0.50, а капсула сама поднимается только на
# PLAYER_STEP_HEIGHT 0.35, то есть на кровать нельзя ВСТАТЬ.
#
# СТОИТ В СТОРОНЕ ОТ ПУТИ ОЧЕРЕДИ, и это не вкус: заданная очередь
# (DFN_STAND_SEQ=1) ходит от спавна ВПЕРЁД (-Z) и наискось влево, а ящик стоит
# ВПРАВО от спавна за кроватью. Предмет, вставший на дороге у очереди, поменял
# бы все прежние приёмочные кадры походки — а они сняты и лежат в отчётах.
[house]
file = assets/houses/stand-crate-h028.dfh
pos = 137.400 25.500 135.400
yaw = 0
note = ящик 1.2 x 1.2, верх 0.28: единственная поверхность стенда, на которой стоят ОБЕИМИ ногами

# ТОЧКА «НА ЯЩИКЕ» — ДОЗА, А НЕ ВТОРОЙ СПАВН КАРТЫ. Обычный прогон стенда её
# не видит: она берётся только дверью DFN_STAND_SPAWN=crate, и разница между
# двумя руками сравнения тогда — ровно эта дверь (правило 47). Высота 25.79 =
# настил 25.500 + верх ящика 0.280; капсула садится на крышку сама.
[spawn]
name = crate
pos = 138.000 25.790 136.000
yaw = 3.14159265
note = на крышке ящика, лицом к лавке и к дому: приёмка пункта 3 (стопы на предмете)

# ВТОРАЯ ТОЧКА ДОЗЫ — НА МАТРАСЕ. Кровать владелец назвал первой, и она злее
# ящика: матрас 1.15 м в ширину при стойке фигуры 0.3 м, поэтому промах в
# полшага ставит одну стопу НА раму, а не на матрас — ровно тот случай, из
# которого «одна стопа парит» и берётся.
[spawn]
name = bed
pos = 134.450 26.000 135.830
yaw = 1.57079633
note = на матрасе кровати (0.50): вторая рука приёмки пункта 3

# ТРЕТЬЯ ТОЧКА — У КРОМКИ ЯЩИКА. Ящик кончается на x = 138.6, фигура стоит в
# 138.45 лицом на +Z: одна стопа на крышке, вторая свисает над настилом на
# 0.28 ниже. Это и есть предъявление «одна стопа парит» — на середине крышки
# обе стопы стоят и без починки.
[spawn]
name = crate-edge
pos = 138.450 25.790 136.000
yaw = 3.14159265
note = у кромки ящика: стопы на РАЗНЫХ грунтах, 0.28 м врозь

# ТОЧКИ «У МАРША» И «НА ПРОСТУПИ» ЗДЕСЬ НЕТ, И ЭТО НАЗВАННЫЙ ХВОСТ, а не
# забывчивость. Дополнение владельца 31.08-3 просит кадр НА САМИХ СТУПЕНЯХ;
# точка под него считается по чертежу марша (0.18 x 0.28, рыск pi/2 в (126,118)),
# и посчитанная точка на третьей проступи оказалась ВНУТРИ СКЛОНА: окрестная
# земля у стенда выше отметки настила, и марш стоит в ней глубже, чем следует
# из отметок площадок. Ставить точку «примерно там» нельзя — кадр приёмки,
# снятый из фигуры, наполовину утонувшей в холме, доказывает обратное тому,
# ради чего снят. Числа про ступени приёмка даёт ctest-ом (набор
# the_feet_stay_on_the_ground, канонический марш и одиночная кромка); кадр
# ждёт правки ПОСАДКИ МАРША в этой сцене, и это работа про стенд, а не про
# стопу.
