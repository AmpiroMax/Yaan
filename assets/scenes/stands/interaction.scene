# Daggerfall N — СТЕНД ВЗАИМОДЕЙСТВИЯ: ПОЗЫ, ПОСАДКА, ХВАТ.
#
# ЧТО ЗДЕСЬ СТОИТ И ЗАЧЕМ КАЖДОЕ. Стенд не комната: четыре станции, каждая
# отвечает за одно утверждение о фигуре у предмета.
#   обеденная группа  — «сесть ЗА СТОЛ»: сидящего разворачивает столешница
#                       (SpotKind::Table, см. seat_facing), и без стола рядом
#                       эта ветка посадки не проверяется ничем;
#   отдельная лавка   — «сесть» без стола: тот же клип, другая причина поворота;
#   кровать           — «лечь»;
#   стеллаж-хват      — три высоты руки на одной станции: 0.80 / 1.38 / 1.93.
#
# ЧИСЛА ВЫСОТ — ЗАМЕРЫ, А НЕ ЖЕЛАНИЯ. Всякая отметка ниже взята с самого
# чертежа (assets/houses/*.dfh) или с полки объектов (assets/objects/furniture/
# INDEX.md), и в примечании каждого предмета стоит та высота, по которой он
# сюда поставлен. Второй копии этих чисел нигде нет: классификатор мебели
# (FurnitureSeats.h) меряет ТУ ЖЕ геометрию сам.
#
# РАССТОЯНИЕ МЕЖДУ СТАНЦИЯМИ — НЕ ВКУС. Прицел мебели берёт предмет в радиусе
# SEAT_REACH_M = 1.2 м от габарита; две точки посадки ближе 2.4 м попадали бы
# в руку ОДНОВРЕМЕННО, и «Сесть» означало бы то одно, то другое. Здесь между
# лавкой обеденной группы, отдельной лавкой и кроватью — 3.30 и 3.00 м по
# ближайшим точкам тел, то есть с запасом. Подход к предмету автопилот ведёт
# с трёх метров, и станции разнесены так, что по дороге к одной он не задевает
# соседнюю.
#
# ЧЕРТЕЖИ [house], А НЕ ССЫЛКИ [place], У ВСЕЙ МЕБЕЛИ, НА КОТОРОЙ СИДЯТ ИЛИ
# ЛЕЖАТ: точки позы собираются по геометрии ЧЕРТЕЖА, и лавка-картинка сидеть
# не даст (тот же довод стоит в стенде персонажа). Ссылками [place] стоит
# только мелочь, которую берут в руку, — она ничего не обещает, кроме места.
#
# БОЕВЫЕ КАРТЫ ЭТОЙ ВОЛНОЙ НЕ ТРОНУТЫ НИ БАЙТОМ.
map = stands/interaction
world_span_m = 256

# СПАВН — ОН ЖЕ ТОЧКА КАДРА. Фигура стоит на середине настила лицом на -Z
# (рыск 0 — конвенция PlayerMovement), то есть ко всем четырём станциям сразу:
# слева стеллаж-хват, дальше обеденная группа, отдельная лавка и кровать.
# Ближайшая точка посадки — лавка за столом в 3.7 м: один заход вперёд, и
# автопилот подхода включается на её глазах, а не до первого кадра.
spawn = 128.000 0 136.000
spawn_yaw = 0.000

# --- ПЛОЩАДКА -----------------------------------------------------------
# Прямоугольник 24 x 16 на отметке 25.5 — та же отметка, что у стенда
# персонажа, потому что земля стенда Gallery лежит около 25 м и кайма ложится
# на неё без обрыва. ОДНА отметка на весь стенд и никакой второй террасы:
# всякий уклон под предметом добавил бы в кадр позы разницу грунта, а мерится
# здесь разница ПРЕДМЕТОВ. Ближайший предмет отстоит от кромки настила на
# 2.8 м, то есть ни одна станция не стоит на скате каймы.
[pad]
center = 128 132
half_extents = 12 8
blend = 6
height = 25.500
note = ровный настил стенда: под каждой станцией одна и та же отметка 25.500

# --- СТАНЦИЯ 1: СТЕЛЛАЖ-ХВАТ, ТРИ ВЫСОТЫ РУКИ ---------------------------
# ЗАЧЕМ СТОЛ ЗДЕСЬ, КОГДА СТОЛ ЕСТЬ У ОБЕДЕННОЙ ГРУППЫ. Нижняя высота хвата
# должна сниматься тем же кадром, что средняя и верхняя, иначе три варианта
# анимации сравниваются через переход камеры между станциями. Стол хвата и
# стеллаж стоят в 0.6 м друг от друга — БЛИЖЕ правила 2.5 м, и это не промах:
# правило охраняет ПРИЦЕЛ ПОСАДКИ, а ни стол (SpotKind::Table — обстановка, не
# поза), ни стеллаж (площадки 2.05 — выше всех порогов) точки посадки не дают.
# Спутать здесь нечего.
[house]
file = assets/houses/furn-table.dfh
pos = 119.600 25.500 131.000
yaw = 0
note = стол хвата: столешница 0.80 (плита 0.765 + полтолщины) — НИЖНЯЯ высота руки

# ЯЩИК ПОД СТЕЛЛАЖОМ — АРИФМЕТИКА, А НЕ УБРАНСТВО. Полки стеллажа испечены в
# чертеже на 0.55 / 1.10 / 1.65 от его низа, и промежуточных высот он не даёт
# вовсе; заказанные окна 1.2–1.4 и 1.8–2.0 он попадает только приподнятым.
# Ящик стенда высотой 0.28 (stand-crate-h028, канон 80% от PLAYER_STEP_HEIGHT)
# поднимает полки ровно в эти окна: 0.83 / 1.38 / 1.93. Подставка НАСТОЯЩАЯ —
# стеллаж стоит на теле, а не висит на выбранной отметке: висящая мебель на
# мерном стенде доказывала бы обратное тому, ради чего стенд заведён.
[house]
file = assets/houses/stand-crate-h028.dfh
pos = 122.000 25.500 130.500
yaw = 0
note = ящик 1.2 x 1.2, крышка 0.28: подставка стеллажа, она же ступень к верхней полке

# СТЕЛЛАЖ РАЗВЁРНУТ ОТКРЫТОЙ СТОРОНОЙ К СПАВНУ (рыск pi): в чертеже задние
# жерди стоят по местному +Z, и без разворота полки смотрели бы от человека.
# ПО ПЕРЕДНЕЙ КРОМКЕ ЯЩИКА, а не по его середине: ящик глубже стеллажа на
# 0.85 м, и середина оставила бы перед полками приступку в 0.42 м — руке
# пришлось бы тянуться через неё, и замер «достаёт ли рука» мерил бы ящик.
[house]
file = assets/houses/furn-shelf.dfh
pos = 123.200 25.780 131.700
yaw = 3.141593
note = стеллаж 1.1 x 0.35 на ящике: полки 26.330 / 26.880 / 27.430 = 0.83 / 1.38 / 1.93 над настилом

# НИЖНЯЯ ПОЛКА (0.83) ОСТАВЛЕНА ПУСТОЙ НАРОЧНО: она повторяет высоту стола
# хвата с точностью до 3 см, и предмет на ней добавил бы четвёртый вариант,
# неотличимый от первого. Три предмета — три высоты, и ни одной лишней.

[place]
object = furn-jug
pos = 122.500 26.880 131.420
yaw = 0.000000
scale = 1
note = кувшин на средней полке 1.38: СРЕДНЯЯ высота, хват за ручку

[place]
object = furn-bottle
pos = 122.550 27.430 131.450
yaw = 0.000000
scale = 1
note = бутыль на верхней полке 1.93: ВЕРХНЯЯ высота, рука выше плеча

[place]
object = furn-cup
pos = 120.100 26.300 131.300
yaw = 0.000000
scale = 1
note = кубок на столе хвата 0.80: мелкий предмет, хват одной рукой

[place]
object = furn-bowl
pos = 120.600 26.300 131.280
yaw = 0.000000
scale = 1
note = миска на столе хвата 0.80: широкий предмет, хват двумя руками

# --- СТАНЦИЯ 2: ОБЕДЕННАЯ ГРУППА (СЕСТЬ ЗА СТОЛ) ------------------------
[house]
file = assets/houses/furn-table.dfh
pos = 126.400 25.500 130.600
yaw = 0
note = стол 1.8 x 0.9, столешница 0.80: по нему разворачивается сидящий на лавке

# ЛАВКА, А НЕ СТУЛ, СИДИТ ЗА ЭТИМ СТОЛОМ, И ЭТО ЗАМЕР, А НЕ ВКУС.
# Классификатор считает сиденьем площадку не короче SEAT_MIN_LONG_M = 0.80 м;
# у стула (furn-chair) сиденье замерено 0.46 x 0.46 при высоте 0.44 — по
# высоте проходит, по длине нет, и точки посадки он НЕ ДАЁТ. Лавка 1.60 x 0.35
# при высоте 0.45 проходит обе меры. Стул стоит здесь же (см. ниже) именно
# затем, чтобы эта разница была видна в кадре, а не только в тесте.
[house]
file = assets/houses/furn-bench.dfh
pos = 126.500 25.500 131.950
yaw = 0
note = лавка за столом: настил 0.45 (плита 0.4225 + полтолщины) — посадка ЗА СТОЛОМ

# СТУЛ СТОИТ ЛИЦОМ К СТОЛУ (спинка по местному -Z, рыск 0): предъявление того,
# что подсказка «Сесть» на нём НЕ ГОРИТ, — и это предъявление, а не недочёт.
# Он же — единственный на стенде предмет с высокой спинкой: если посадка
# когда-нибудь начнёт различать спинку, мерить её будет здесь.
[house]
file = assets/houses/furn-chair.dfh
pos = 127.000 25.500 129.550
yaw = 0
note = стул: сиденье 0.44, площадка 0.46 x 0.46 — короче порога 0.80, посадки НЕ даёт

[place]
object = furn-bread
pos = 127.100 26.300 130.950
yaw = 0.000000
scale = 1
note = каравай на столе 0.80: хват СИДЯ, единственный на стенде

# --- СТАНЦИЯ 3: ОТДЕЛЬНАЯ ЛАВКА (СЕСТЬ БЕЗ СТОЛА) -----------------------
# Стоит в 3.30 м от лавки обеденной группы по ближайшим точкам тел. Та же
# мебель и тот же клип, но столешницы рядом нет — и сидящий разворачивается
# по середине локации, а не по столу. Две ветки seat_facing на одном стенде,
# и различить их можно одним шагом вбок.
[house]
file = assets/houses/furn-bench.dfh
pos = 131.400 25.500 131.600
yaw = 0
note = лавка без стола: настил 0.45 — посадка, развёрнутая НЕ столом

# --- СТАНЦИЯ 4: КРОВАТЬ (ЛЕЧЬ) ------------------------------------------
# Изголовье по местному -Z, то есть при рыске 0 голова лежащего уходит от
# спавна, а подходят к кровати с ног: так же, как к ней подходят в доме.
# 3.00 м до отдельной лавки — ближайший сосед, и это больше двух радиусов руки.
[house]
file = assets/houses/furn-bed.dfh
pos = 136.000 25.500 130.300
yaw = 0
note = кровать 1.15 x 1.99: матрас 0.50 (плита 0.47 + полтолщины) — поза «лежать»
