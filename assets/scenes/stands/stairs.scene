# Daggerfall N — СТЕНД ЛЕСТНИЦ (заказ владельца 07.09).
#
# ЧТО ЗДЕСЬ ЕСТЬ И ЗАЧЕМ. Одно мерило — нога на ступени:
#   лестничный коридор — пять свободностоящих мостиков «подъём — площадка
#                        1.5 — спуск» в линию по +X: 19°, 27°, 33° (канон
#                        0.18/0.28), 42°, 54°; каждый проверяет и подъём, и
#                        спуск, зазор между мостиками 2 м;
#   терраса + марш     — канонический марш 0.18/0.28 (9 ступеней, 1.62 м),
#                        ведущий с площадки на террасу 1.6 м: посажен ПЕРЕД
#                        откосом, а не внутри него (у стенда персонажа марш у
#                        подножия ската уходит в склон — там его не проверить).
#   ровная площадка    — как у стенда персонажа: разница двух рук без рельефа.
#
# Мостики — испытательные: судья маршей (dfn_stairs_check) знает класс
# stand-*.dfh и печатает их нарушения «ожидаемо» по паспорту
# tests/known_stair_findings.txt.
map = stands/stairs
world_span_m = 256

# СПАВН — западный конец коридора, лицом на восток (+X): первый мостик в двух
# метрах, идёшь прямо и проходишь все пять. Терраса с маршем — справа по ходу.
spawn = 106.000 0 141.000
spawn_yaw = 1.57079633

# --- ПЛОЩАДКА -----------------------------------------------------------
[pad]
center = 128 130
half_extents = 20 14
blend = 6
height = 25.500
note = ровный настил

# --- ТЕРРАСА 1.6 м с ОТКОСОМ 1 м: на неё ведёт канонический марш --------
# Кромка террасы по z = 112; откос (blend = 1) крутой, по нему не ходят —
# ходят по маршу, который стоит на площадке перед кромкой и кончается на
# уровне террасы.
[pad]
center = 128 104
half_extents = 12 8
blend = 1
height = 27.100
note = терраса: подъём 1.6 м, кромка z = 112

# Марш стоит у x = 128, подножие на z = 114.6 (площадка 25.5), 9 x 0.18 = 1.62
# м подъёма за 9 x 0.28 = 2.52 м выноса → верх на z = 112.08 в 0.02 м над
# террасой. Спуститься можно им же.
[house]
file = assets/houses/stand-steps9-h162.dfh
pos = 128.000 25.500 114.600
yaw = 1.570796
note = канонический марш 0.18/0.28 на террасу, 9 ступеней

# --- ЛЕСТНИЧНЫЙ КОРИДОР ------------------------------------------------
[house]
file = assets/houses/stand-bridge-h12.dfh
pos = 108.000 25.500 141.000
yaw = 0
note = мостик 19 град: 9 x 0.12/0.35, длина 7.80

[house]
file = assets/houses/stand-bridge-h15.dfh
pos = 117.800 25.500 141.000
yaw = 0
note = мостик 27 град: 7 x 0.15/0.30, длина 5.70

[house]
file = assets/houses/stand-bridge-h18.dfh
pos = 125.500 25.500 141.000
yaw = 0
note = мостик 33 град: 6 x 0.18/0.28, длина 4.86

[house]
file = assets/houses/stand-bridge-h21.dfh
pos = 132.360 25.500 141.000
yaw = 0
note = мостик 42 град: 5 x 0.21/0.23, длина 3.80

[house]
file = assets/houses/stand-bridge-h25.dfh
pos = 138.160 25.500 141.000
yaw = 0
note = мостик 54 град: 4 x 0.25/0.18, длина 2.94

