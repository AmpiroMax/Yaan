# Daggerfall N — СТЕНД НОМЕНКЛАТУРЫ: КОМНАТА ПО СКРИНУ.
#
# Эталон — images_examples/houses_indoors/image copy 9.png: общая комната
# бревенчатого дома Скайрима. Она выбрана из девятнадцати не «на вкус», а по
# счёту предметов: на ней ОДНОВРЕМЕННО стоит одиннадцать позиций из партии
# (стол, четыре стула, полка с едой, бочка, корзина, шкура, ковёр, посуда,
# котёл над огнём, комод, свечи) — больше, чем на любом другом скрине.
#
# ЧТО ЭТА СЦЕНА ДОКАЗЫВАЕТ. Каждый предмет обстановки стоит ССЫЛКОЙ [place]
# object=, то есть телом с полки assets/objects/furniture — тем самым, что
# лежит в перечне INDEX.md с замером и хэшем. Не рецептом, разложенным по
# месту: разложенный по месту рецепт доказал бы, что мы умеем нарисовать
# комнату, а нужно доказать, что у нас есть НАБОР, который эту комнату
# повторяет. Единственные [house] здесь — оболочка дома, каменный очаг и
# пламя: очаг и пламя печь реестра НЕ БЕРЁТ (пламя косметическое, очаг несёт
# износ по месту), и это названо вслух, а не спрятано.
#
# ЭТО СТЕНД, А НЕ ГОРОД. Боевые сцены (whiterun, cornhall) этой волной не
# тронуты ни байтом: расстановка партии по домам — следующая волна правил
# дизайна.
#
# РАСКЛАДКА РУКАМИ, И ЧИСЛА ЗДЕСЬ — ОКОНЧАТЕЛЬНЫЕ. Генератора у стенда нет
# нарочно: он мерило («повторяет ли набор их комнату»), а мерило, которое
# пересобирается само, назавтра померит что-то другое.
#
# Оболочка — city-house-s (внутренность 4.5 x 6.0, пол на 0.120, дверь в
# южной стене по x = 2.25). НАЧАЛО КОМНАТЫ — мировая точка (125.0, 25.50,
# 139.0), то есть северо-западный угол пола; всякое число ниже читается как
# «начало плюс местная отметка рецепта», и переносится комната сложением.
#
# ПОЧЕМУ СТЕНД СТОИТ НА ЗЕМЛЕ, А НЕ ЛОКАЦИЕЙ-ИНТЕРЬЕРОМ. Локации из
# assets/scenes/int/* открываются ПОРТАЛОМ из города и своего манифеста не
# имеют вовсе; открыть их напрямую нечем. Меню карт умеет ровно две схемы
# источника — stand: и dfw: (App.cpp, open_map), и «scene:» среди них нет.
# Стенд, который нельзя открыть, мерилом не работает.
map = interiors/furniture-room
world_span_m = 256
# СПАВН — И ЕСТЬ ТОЧКА КАДРА СТЕНДА: у входа в юго-западном углу, лицом на
# северо-восток, к очагу. Кадр приёмки снимается ОТТУДА ЖЕ, куда попадает
# пришедший, а не с особой точки, которую видит только агент.
spawn = 126.600 0 144.800
spawn_yaw = 0.350

[pad]
center = 127 142
half_extents = 24 18
blend = 8
height = 25.5
note = ровная площадка стенда: комната сравнивается со скрином, а не с рельефом

[house]
file = assets/houses/city-house-s.dfh
pos = 125.000 25.500 139.000
yaw = 0
sealed = 1
note = оболочка комнаты: тот же чертёж, что стоит в городе

# --- ОЧАГ У ВОСТОЧНОЙ СТЕНЫ (эталон: очаг справа по кадру) --------------
# Очаг и пламя — [house], а не ссылка: печь реестра отказывает обоим по
# своим правилам (износ по месту у камня, косметический слой у пламени).
[house]
file = assets/houses/furn-hearth.dfh
pos = 128.100 25.620 140.000
yaw = 0.000000
note = каменный очаг

[house]
file = assets/houses/furn-fire.dfh
pos = 128.500 25.820 140.400
yaw = 0.000000
note = огонь очага

