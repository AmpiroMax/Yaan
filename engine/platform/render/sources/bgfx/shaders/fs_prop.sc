$input v_color0, v_normal, v_texcoord0, v_wpos

// Prop fragment (stage 3b): flat vertex-color albedo for placeholder meshes
// (scatter flora/stones, site structures) — faceted normals give the
// hard-edged low-poly read (LANDSCAPE §5/§6). Same lighting model, sun
// shadows (в1, dfn_shadow.sh) and fog as terrain so props sit in the scene
// instead of floating on it. Shares vs_terrain (PROGRAM_TABLE pairs
// "prop" = vs_terrain + fs_prop).

#include <bgfx_shader.sh>
#include "dfn_env.sh"
#include "dfn_shadow.sh"

SAMPLER2D(s_texColor, 0);
SAMPLER2D(s_texAux, 4); // DrawParams::aux_texture — лист нормалей материала

// x: texture bound (1 = tile, 2 = mipped mask, 3 = UNWRAPPED SHEET on a
//    skinned draw: the sheet IS the albedo, no vertex tint, no macro noise;
//    4 = the same sheet in COVERAGE mode: a skinned cutout (hair, lashes)
//    with a mipped mask on a multisampled target -- alpha goes out as
//    coverage, as fs_foliage does at 2),
// y: DrawParams::fade, z: highlight, w: aux sheet bound.
uniform vec4 u_params;
// ОТРАЖАТЕЛЬНАЯ ПОЛОВИНА МАТЕРИАЛА (зона МАТЕРИАЛЫ, 28.08, заказ владельца:
// «для золота/металла уже есть нужда — герб»).
//   x = шероховатость 0..1 (1 — чистый ламберт, то есть кадр ДО этой волны)
//   y = металличность 0..1 (окрашивает блик альбедо вместо белого)
//   z = ПОРОГ ВЫРЕЗА ПО АЛЬФЕ ЛИСТА (DrawParams::alpha_cutoff; 0 — выреза
//       нет, кадр бит-в-бит прежний) — прядь волос, ресница, бровь
//   w = ДВУСТОРОННИЙ СВЕТ (DrawParams::two_sided): нормаль к глазу, как у
//       карточки листвы, иначе изнанка пряди чёрная
uniform vec4 u_matParams;

// Below this the texel is empty in coverage mode (fs_foliage's own number).
#define PART_ALPHA_EMPTY 0.02

void main()
{
    dfn_screen_door(u_params.y, gl_FragCoord.xy); // LOD cross-fade / per-draw dissolve
    vec3 n = normalize(v_normal);
    // --- ВЫРЕЗ ПО АЛЬФЕ ЛИСТА (u_matParams.z > 0; волна «части персонажа»).
    // До света и до рельефа: пустой тексель не пишет ни цвета, ни глубины.
    // В режиме покрытия (u_params.x = 4) жёсткий порог сменяется на «почти
    // пусто», а сама альфа уходит в кадр покрытием — та же механика и те же
    // доводы, что у листвы (fs_foliage: среднее по мипу сохраняет площадь).
    float part_alpha = 1.0;
    float coverage_mode = step(3.5, u_params.x);
    if (u_matParams.z > 0.0) {
        part_alpha = texture2D(s_texColor, v_texcoord0).a;
        if (part_alpha < mix(u_matParams.z, PART_ALPHA_EMPTY, coverage_mode)) {
            discard;
        }
    }
    // --- ДВУСТОРОННИЙ СВЕТ (u_matParams.w): нормаль карточки разворачивается К
    // СОЛНЦУ, а не к глазу, — это |N·L| для солнца: прядь толщиной в тексель
    // освещена с той стороны, с которой на неё светят, и изнанка под фронтальным
    // светом не чёрная. Разворот к глазу (как у листвы) здесь хуже: у пряди,
    // увиденной с теневой стороны, он гасил бы солнце, которое её же и
    // подсвечивает насквозь. До теней и рельефа: смещение по нормали в
    // dfn_shadow_factor и базис Грама-Шмидта ниже строятся на развёрнутой.
    // Точечные светы остаются односторонними — хвост.
    if (u_matParams.w > 0.5) {
        n = dot(n, u_sunDir) < 0.0 ? -n : n;
    }
    // --- РЕЛЬЕФ МАТЕРИАЛА (u_params.w = привязан лист нормалей). Заказ 19.08:
    // «у стен и столбов текстуры объём, как у собранных деталей» — детали носят
    // рельеф через ЭТОТ ЖЕ механизм в fs_foliage (тангенс из экранных
    // производных, Грам-Шмидт, вырожденный градиент падает в геометрическую
    // нормаль). Скопировано оттуда сознательно и с тем же устройством: у
    // шейдеров нет общего include под это, а два РАЗНЫХ способа считать базис
    // дали бы стенам рельеф, наклонённый иначе, чем у деталей рядом.
    if (u_params.w > 0.5) {
        vec3 dp1 = dFdx(v_wpos);
        vec3 dp2 = dFdy(v_wpos);
        vec2 du1 = dFdx(v_texcoord0);
        vec2 du2 = dFdy(v_texcoord0);
        float det = du1.x * du2.y - du2.x * du1.y;
        if (abs(det) > 1e-12) {
            vec3 tangent = normalize((dp1 * du2.y - dp2 * du1.y) / det);
            tangent = normalize(tangent - n * dot(n, tangent));
            vec3 bitangent = cross(n, tangent);
            vec3 tn = texture2D(s_texAux, fract(v_texcoord0)).xyz * 2.0 - 1.0;
            n = normalize(tangent * tn.x + bitangent * tn.y + n * tn.z);
        }
    }
    float vis = dfn_shadow_factor(v_wpos, n);
    // АЛЬБЕДО: ПЛИТКА, ЕСЛИ ОНА ПРИВЯЗАНА, иначе плоский цвет вершины.
    // u_params.x бэкенд выставлял ВСЕГДА, читал его здесь никто — постройка
    // редактора (19.08) первая, кому плитка нужна: её uv считаны В МЕТРАХ, и
    // fract() повторяет узор столько раз, сколько метров у стены. Цвет вершины
    // остаётся МНОЖИТЕЛЕМ: у текстурируемых потоков он белый, а тонированные
    // меши без плитки не меняются ни на бит.
    vec3 albedo = v_color0.rgb;
    if (u_params.x > 2.5) {
        // КОЖА ПЕРСОНАЖА (волна «текстура на скиннинге»): лист развёрнут по
        // телу, а не повторяется по метрам, поэтому ни fract(), ни шума по
        // мировым координатам — шум полз бы по коже при ходьбе. Цвет вершины
        // не множит: в вершинах лежит ПАЛИТРА ЧАСТЕЙ ТЕЛА — запасная рука
        // (DFN_BODY_PALETTE=1), которая рисует тело, когда листа нет.
        albedo = texture2D(s_texColor, v_texcoord0).rgb;
    } else if (u_params.x > 0.5) {
        albedo *= texture2D(s_texColor, fract(v_texcoord0)).rgb;
        // МАКРО-ВАРИАЦИЯ ПРОТИВ РЯБИ (заказ 20.08: «текстуры везде одинаковые,
        // повторяются — видно, что объект искусственный»). Плитка метровая, и
        // на большой стене её период читается глазом; два слоя ценностного
        // шума по МИРОВЫМ координатам (периоды ~7 м и ~2.3 м, амплитуда ±12%)
        // рассинхронизируют повторы. По миру, а не по uv — сосед-кусок кладки
        // получает своё пятно, и стык не палит сетку.
        vec2 wp = v_wpos.xz + v_wpos.yy * 0.37;
        vec2 g1 = floor(wp * 0.14);
        vec2 f1 = fract(wp * 0.14);
        f1 = f1 * f1 * (3.0 - 2.0 * f1);
        #define DFN_H(q) fract(sin(dot(q, vec2(127.1, 311.7))) * 43758.5453)
        float n1 = mix(mix(DFN_H(g1), DFN_H(g1 + vec2(1.0, 0.0)), f1.x),
                       mix(DFN_H(g1 + vec2(0.0, 1.0)), DFN_H(g1 + vec2(1.0, 1.0)), f1.x),
                       f1.y);
        vec2 g2 = floor(wp * 0.43);
        vec2 f2 = fract(wp * 0.43);
        f2 = f2 * f2 * (3.0 - 2.0 * f2);
        float n2 = mix(mix(DFN_H(g2), DFN_H(g2 + vec2(1.0, 0.0)), f2.x),
                       mix(DFN_H(g2 + vec2(0.0, 1.0)), DFN_H(g2 + vec2(1.0, 1.0)), f2.x),
                       f2.y);
        albedo *= 0.88 + 0.16 * n1 + 0.08 * n2;
    }
    // САМОСВЕТНЫЙ ДРО (u_params.z < -0.5, UPD 23:08:2026 - 18:10:31): альбедо без
    // освещения и без теней — пламя и стекло фонаря видны с любого
    // расстояния и с любой грани, независимо от бюджета точечных светов.
    // Воздух поверх остаётся: дальний огонь тает в дымке, как всё в мире;
    // скотопик яркое не серит.
    // ОКОННАЯ ВСТАВКА (u_params.z <= -2.0, 28.08): то же самосвечение, но С
    // СИЛОЙ. Пламя горит своим альбедо и одинаково в полдень и в полночь;
    // лист окна светит НЕБОМ — днём это ярчайшее пятно комнаты и оно обязано
    // уходить в пересвет (у референса владельца контраст p95/p05 медианно
    // 106x против наших 7..24x, и весь разрыв — отсутствие пересвета), ночью
    // почти гаснет. Сила приезжает величиной z (см. BgfxRendererSubmit.cpp),
    // ТОН — вершинным цветом, который у вставки не занят краской: холодный
    // днём, тёплый ночью. Час суток считает зона app на входе в дом, потому
    // что окружение подвешенного мира солнца не носит (у локации нет неба).
    //
    // Пересвет не зажимается здесь нарочно: дальше стоит dfn_aerial, и клип
    // до белого делает сам вывод в кадр — ровно так пересвечено окно на
    // каждом из девятнадцати кадров референса.
    if (u_params.z < -1.5) {
        float pane = -u_params.z - 2.0;
        // ЯРКОСТЬ — ОТ ПЛИТКИ, ЦВЕТ — ОТ ВЕРШИНЫ, и разделены они нарочно.
        // Плитка глухого окна нарисована для взгляда СНАРУЖИ: тёмная дыра с
        // тёплой оранжевой глубиной (PartsAtlas::pane_texel). Изнутри днём за
        // этим же листом стоит НЕБО, и оранжевая глубина там — брак, а не
        // полутон. От плитки берётся то, что верно с обеих сторон: переплёт,
        // грязь, неровность (её светлота); цвет назначает вершина, которой
        // зона app сказала час суток.
        float pane_l = 1.0;
        if (u_params.x > 0.5) {
            pane_l = dot(texture2D(s_texColor, fract(v_texcoord0)).rgb,
                         vec3(0.2126, 0.7152, 0.0722));
        }
        gl_FragColor =
            vec4(dfn_aerial(v_wpos, v_color0.rgb * (pane_l * pane)), 1.0);
        return;
    }
    if (u_params.z < -0.5) {
        gl_FragColor = vec4(dfn_aerial(v_wpos, albedo), 1.0);
        return;
    }
    // Vertex alpha is the sky-visibility channel (1.0 on everything built
    // above ground); dfn_surface_light adds moon and torch on top of sun.
    vec3 lit = albedo * dfn_surface_light(v_wpos, n, vis, v_color0.a);
    // --- БЛИК МАТЕРИАЛА (зона МАТЕРИАЛЫ, 28.08) ---------------------------
    //
    // ПОЧЕМУ ЭТА ВОЛНА ВООБЩЕ СУЩЕСТВУЕТ, ОДНОЙ СТРОКОЙ: до неё у ВСЕГО в
    // мире отражение было одно — ламбертово. Золото герба, чугун петли и
    // извёстка стены отличались только числом, записанным в цвет вершины, а
    // золото от горчицы отличается не числом, а тем, КАК оно отражает.
    //
    // ВЕТКА НЕ ВХОДИТ ПРИ roughness == 1, И ЭТО КОНТРОЛЬНАЯ РУКА (правило 47):
    // умолчание DrawParams — ровно единица, значит всякий дро, который про
    // материал промолчал, выходит из ЭТОГО ЖЕ бинарника бит-в-бит прежним.
    if (u_matParams.x < 0.999) {
        vec3 eye = mul(u_invView, vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        vec3 view_dir = normalize(eye - v_wpos);
        // Блинн-Фонг с нормировкой, а не GGX: у нас forward-проход без
        // предвычисленного окружения и палитра в 8 ступеней на рампу —
        // микрофасетная модель отдала бы разницу, которая на этой квантизации
        // не выражается. Показатель выводится из шероховатости так, что 1
        // даёт широчайшую долю, а 0.22 (золото) — собранную полосу.
        float a = max(u_matParams.x * u_matParams.x, 1e-3);
        float shininess = 2.0 / (a * a) - 2.0;
        // ЛЕПЕСТОК НОРМИРОВАН ПО ПИКУ (пик = 1), А НЕ ПО ЭНЕРГИИ, И ЭТО
        // ИЗМЕРЕННОЕ РЕШЕНИЕ, А НЕ УПРОЩЕНИЕ.
        //
        // Первая версия несла классическую энергетическую нормировку Блинна
        // (n+8)/(8*pi) — она сохраняет полную энергию лепестка, поэтому
        // сужение не гасит блик, и это правильно для конвейера с HDR и
        // тональной компрессией. У НАС ИХ НЕТ: forward-проход пишет прямо в
        // LDR-цель, а сверху стоит палитра в 8 ступеней на рампу.
        //
        // Чем это кончилось, числом с кадра золотого герба (шероховатость
        // 0.22 -> показатель ~851 -> множитель нормировки ~34):
        //     подложка под пиками блика  rgb(120, 84, 28)   (золото полки)
        //     прибавка на тех же пикселях rgb(135,171,227)
        //     сумма                       rgb(255,255,255)
        // Прибавка ОКАЗАЛАСЬ РОВНО ОСТАТКОМ ДО 255 по каждому каналу — то
        // есть блик выбивался в чистый белый и терял ровно то, ради чего
        // материал заведён: ЦВЕТ МЕТАЛЛА. Золотой блик, обрезанный в белый,
        // неотличим от блика на извёстке, и волна доказывала бы обратное
        // тому, что утверждает.
        //
        // Цена решения названа честно: с пиком 1 шершавый материал даёт
        // блик той же высоты, но шире, то есть шероховатость управляет
        // ПЛОЩАДЬЮ, а не яркостью. Это классический Блинн-Фонг и обычный
        // выбор LDR-конвейеров. Отношение «пик / склон» — то, чем тест
        // отличает золото от штукатурки, — от нормировки не зависит вовсе,
        // поэтому проверка пережила эту правку не изменившись.
        float norm = 1.0;
        // МЕТАЛЛ ОКРАШИВАЕТ СВОЙ БЛИК, ДИЭЛЕКТРИК — НЕТ. Это и есть вся
        // разница между золотом и жёлтой краской: у краски блик белый, у
        // золота — золотой. 0.04 — отражение диэлектрика в упор, единственное
        // число здесь, взятое из физики, а не из вкуса.
        vec3 f0 = mix(vec3_splat(0.04), albedo, u_matParams.y);
        vec3 spec_sum = vec3_splat(0.0);
        // СОЛНЦЕ. u_sunDir указывает НА солнце (контракт dfn_env.sh), то есть
        // это уже вектор к источнику. Тень солнца множит блик так же, как
        // рассеянную долю: блик в тени — это солнце, светящее сквозь стену.
        {
            vec3 half_dir = normalize(u_sunDir + view_dir);
            float ndotl = max(dot(n, u_sunDir), 0.0);
            spec_sum += u_sunColor
                      * (pow(max(dot(n, half_dir), 0.0), shininess) * norm
                         * ndotl * vis);
        }
        // ТОЧЕЧНЫЕ ИСТОЧНИКИ, И БЕЗ НИХ ЭТА ВОЛНА НИЧЕГО БЫ НЕ ПОКАЗАЛА.
        // Найдено кадром, а не рассуждением: первая версия считала блик
        // только от солнца, и две руки замера золотого герба вышли
        // ПОБИТОВО ОДИНАКОВЫМИ (md5 совпал). Причина — главное меню светит
        // предмету СВОИМИ источниками (light_menu_screen), а солнца в кадре
        // меню нет вовсе. То есть металл, ради которого волна затевалась,
        // жил ровно там, где блик не считался.
        //
        // Это не частный случай меню: интерьер, факел, очаг и фонарь — весь
        // ночной и внутренний мир освещён точечными. Металл, бликующий
        // только на солнце, — это металл, который гаснет в доме.
        //
        // Затухание взято ТО ЖЕ, что у рассеянной доли в dfn_surface_light
        // (smoothstep по линейному окну), чтобы блик не пережил свет,
        // который его породил. Тень куба сюда сознательно НЕ заводится:
        // теневых слотов два на кадр, а блик — добавка поверх уже
        // затенённой рассеянной доли.
        for (int i = 0; i < DFN_MAX_LIGHTS; ++i) {
            if (float(i) >= u_lightCount) {
                break;
            }
            vec4 pos_rad = u_lightPosRad(i);
            vec3 to_light = pos_rad.xyz - v_wpos;
            float dist = length(to_light);
            float atten = clamp(1.0 - dist / max(pos_rad.w, 0.0001), 0.0, 1.0);
            if (atten <= 0.0) {
                continue;
            }
            vec3 light_dir = to_light / max(dist, 0.0001);
            vec3 half_dir = normalize(light_dir + view_dir);
            float ndotl = max(dot(n, light_dir), 0.0);
            float fall = atten * atten * (3.0 - 2.0 * atten);
            spec_sum += u_lightColor(i).rgb
                      * (pow(max(dot(n, half_dir), 0.0), shininess) * norm
                         * ndotl * fall);
        }
        lit += f0 * spec_sum;
    }
    // Альфа несёт ПОКРЫТИЕ в режиме покрытия и 1.0 иначе (см. вырез выше).
    gl_FragColor = vec4(dfn_aerial(v_wpos, lit), mix(1.0, part_alpha, coverage_mode));
}
