#!/usr/bin/env bash
#
# Created: 09:08:2026 - 00:06:00
# Last updated: 10:08:2026 - 01:58:01
# File: tools/hooks/pre-commit
#
# Responsibility:
# - Pre-commit gate: enforce the file header/UPD contract before any commit.
#
# Dependencies:
# - Uses: tools/header_check.py (python3).
# - Used by: git (installed into .git/hooks by tools/install_hooks.sh).
#
# AI Agents Notice:
# - Follow docs/ARCHITECTURE.md strictly.
# - Do not bypass with --no-verify; fix the headers instead.
#
# UPD:
# - 09:08:2026 - 00:06:00: Created hook running header_check over the whole tree.
# - 10:08:2026 - 01:58:01: Staged-files-only gate (design's process flag).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
# Check ONLY the staged files: six agents share one working tree, and a
# whole-tree gate lets any agent's mid-edit header block everyone's commits.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then exit 0; fi
# shellcheck disable=SC2086
python3 "$repo_root/tools/header_check.py" --root "$repo_root" --files $staged
