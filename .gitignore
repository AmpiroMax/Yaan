build*/
out/
.cache/
.DS_Store
compile_commands.json
.claude/worktrees/
screenshots/
settings.cfg
captures/
playtest_test_artifacts/
__pycache__/

# Baked maps and their cache: the manifest is the recipe and lives in git, the
# bake is derived and weighs tens to hundreds of MB (docs/MAP_LAYOUT.md, в35).
*.dfw
cache/

# Per-run telemetry beside a map: one line per event of ONE session. The chat
# log next to it (<map>.chat.jsonl) IS tracked — it is the demo's own
# explanation of itself — but the telemetry is the run, not the demo.
*.telemetry.log

# Third-party reference screenshots (Morrowind/Oblivion/Skyrim) — look targets, not ours to ship
images_examples/

# РЕЗУЛЬТАТЫ РАБОТЫ КОДА В GIT НЕ ХРАНЯТСЯ (решение пользователя 17.08.2026:
# «в гит результаты работы кода не сохраняем... ассеты запекать они при первом
# запуске будут»). Полка деталей — детерминированный вывод кузницы, которая
# лежит в этом же репозитории; 185 МБ в истории покупали бы вес НАВСЕГДА за то,
# что код делает за пять секунд. Игра печёт недостающее при первом запуске и
# показывает полоску (engine/app/sources/AssetBake.h).
#
# Печётся сама: assets/objects/parts.
# Таблички (assets/objects/signs) — тот же случай: разбор .signs переехал в
# библиотеку (render::read_signs_file), значит печь приложения может испечь их
# сама; шаг в AssetBake за лидом (17.08). До него на чистом клоне паспорта
# домов печёт `./build_lead/dfn_signs --flat assets/signs/demo.signs`.
# ЕЩЁ НЕ ПЕЧЁТСЯ и потому пока ОСТАЁТСЯ в git: trees, glade, colossus, panels —
# их каталоги живут в tools/, а не в библиотеке, и приложение их не видит.
# Перенести каталоги в библиотеку и вычистить — следующий шаг.
assets/objects/parts/
assets/objects/signs/
# ПЕРСОНАЖИ: .glb/.gltf — ИСХОДНИК (лежит в git, вместе с лицензией), .dfo —
# ВЫПЕЧКА импортёра и потому производная (то же правило, что у деталей).
# Печёт цель dfn_characters на сборке; сети для этого не нужно.
assets/objects/characters/*.dfo

# Общий кэш загруженных зависимостей (FETCHCONTENT_BASE_DIR): вывод загрузчика,
# а не наш исходник.
third_party/_deps/

# ЗАВЕЗЁННАЯ bgfx.cmake (тег v1.153.9398-565 с подмодулями bgfx/bimg/bx).
# Лежит ОТДЕЛЬНО от _deps намеренно: шаг клонирования FetchContent стирает
# каталог назначения перед клонированием, поэтому всё, что положено внутрь
# _deps, он однажды сотрёт. Отсюда его берут через
# FETCHCONTENT_SOURCE_DIR_BGFX_CMAKE, и сеть не нужна вовсе.
third_party/bgfx.cmake/

# Музыка: скачанное извне, не наш исходник.
# ref_midi — референсные MIDI (public domain / CC) для сравнительного анализа
# партитур; sf — саундфонт MuseScore_General (39 МБ, качается по ссылке из
# docs/reports/music-research.html). Партитуры-исходники живут в
# tools/music/compose_demo.py, звук пересобирается из них одной командой.
tools/music/ref_midi/
tools/music/sf/

# Скачанные извне аудио/MIDI-примеры (чужие файлы, не наш исходник).
audio_examples/

# Отрендеренные превью чужих MIDI — материал для прослушивания и разбора, не наш выпуск.
docs/reports/music/ref/
artifacts/reports/music/

# Книги по оркестровке (274 МБ сканов) — справочный материал, не исходники игры.
docs/reference/books/

# Референсные кадры Готики 3 (скриншоты страницы Steam, чужой материал) —
# скачаны для СНЯТИЯ ПРОПОРЦИЙ ко второй итерации деревьев, в игру не идут.
docs/reports/trees-g3/ref/
docs/reports/trees-tiers/ref/g3_*.jpg
docs/reports/trees-tiers/ref/u_*.jpg
docs/reports/materials-spec/ref/skyrim-*.jpg

# Звук, отрендеренный для прослушивания: пробы ритмов, мотивов, тембров, фактур,
# варианты сведения и все версии разбора чужого трека. 397 МБ и растёт с каждой
# пробой. Это материал для уха, а не выпуск: всё пересобирается скриптами из
# tools/music одной командой, а то, что звучит в игре, лежит в assets/audio.
# С 30.08 отчёты переехали в artifacts/ (вся папка вне git), так что правило ниже
# осталось только на случай, если кто-то соберёт звук по старому пути.
docs/reports/music/

# Побочные файлы музыкальных скриптов: импульсные отклики залов (синтезируются
# make_ir.py), скачанные референсные MIDI, промежуточные партитуры и кэш питона.
tools/music/ref_midi_games/
tools/music/ref_midi_rpg/
tools/music/ir/
tools/music/__pycache__/
tools/music/*.mid

# Кадры, приёмки, отчёты, референсы — вне git (решение владельца 30.08)
artifacts/
